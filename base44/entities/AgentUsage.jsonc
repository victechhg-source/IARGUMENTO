      "type": "string"
    },
    "essay_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "school_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_tokens": {
      "type": "number"
    },
    "output_tokens": {
      "type": "number"
    },
