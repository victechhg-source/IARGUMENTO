{
  "name": "AccountGrant",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "director"
      ]
    },
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "account_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
