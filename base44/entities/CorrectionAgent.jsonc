{
  "name": "CorrectionAgent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "banca": {
      "type": "string",
      "enum": [
        "ENEM",
        "FUVEST",
        "UNICAMP",
        "UNIFESP",
        "UFG"
      ]
    },
    "model": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ],
      "default": "draft"
    },
    "trained_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "banca",
    "model"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}