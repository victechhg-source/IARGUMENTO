{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "institutional_code": {
      "type": "string",
      "description": "C\u00f3digo legado da escola (aceito como c\u00f3digo de aluno)"
    },
    "student_code": {
      "type": "string",
      "description": "C\u00f3digo de acesso que cadastra ALUNOS (ALU-XXXXXX)"
    },
    "teacher_code": {
      "type": "string",
      "description": "C\u00f3digo de acesso que cadastra PROFESSORES (PRO-XXXXXX)"
    },
    "director_code": {
      "type": "string",
      "description": "C\u00f3digo de acesso que cadastra DIRETORES (DIR-XXXXXX)"
    },
    "director_id": {
      "type": "string"
    },
    "director_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "institutional_code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}