// SEGURANÇA (Onda 1 do plano QA):
// - update (RLS) é admin-only: o fluxo do dono passou para as functions
//   updateEssayFlow / saveCorrectionResult (service role = admin).
// - create do dono foi MANTIDO em vez de "__disabled__": pela doc do Base44,
//   asServiceRole assume role "admin" mas NÃO bypassa RLS, e um create via
//   service role não garantiria created_by_id = aluno (o read/delete do dono
//   dependem disso). Em compensação, os campos sensíveis (notas, correções,
//   vínculos teacher_ids/school_ids, teacher_note) têm FLS write admin-only:
//   o cliente só consegue criar { banca, status } — todo o resto é escrito
//   pelas functions (createEssay, processEssayScan, updateEssayFlow,
//   saveCorrectionResult, teacherSetNote, reviewClassJoin).
{
  "name": "Essay",
  "type": "object",
  "properties": {
    "banca": {
      "type": "string",
      "enum": [
        "ENEM",
        "FUVEST",
        "UNICAMP",
        "UNIFESP",
        "UFG"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "transcribing",
        "reviewing",
        "correcting",
        "completed"
      ],
      "default": "transcribing"
    },
    "original_image_url": {
      "type": "string"
    },
    "transcription": {
      "type": "string"
    },
    "unrecognized_words": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ocr_confidence": {
      "type": "number"
    },
    "ocr_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ocr_primary": {
      "type": "string"
    },
    "ocr_secondary": {
      "type": "string"
    },
    "ocr_structure_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ocr_needs_review": {
      "type": "boolean"
    },
    "annotated_text": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "memorable_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "teacher_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "school_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "max_score": {
            "type": "number"
          },
          "summary": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "correct",
                    "warning",
                    "error"
                  ]
                },
                "excerpt": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                },
                "suggestion": {
                  "type": "string"
                },
                "video_suggestion": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "final_grade": {
      "type": "number",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "max_grade": {
      "type": "number",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "writing_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "study_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "teacher_note": {
      "type": "string",
      "description": "Coment\u00e1rio do professor sobre a reda\u00e7\u00e3o (escrito via teacherSetNote)",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "banca"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.teacher_ids": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "account_type": "director"
              }
            },
            {
              "data.school_ids": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
