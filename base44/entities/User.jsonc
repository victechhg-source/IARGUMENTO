// LIMITAÇÃO CONHECIDA (documentada na Onda 1 do plano QA):
// A doc do Base44 (backend/resources/entities/user-schema.md) não oferece
// mecanismo para restringir CAMPOS aceitos por auth.updateMe — qualquer campo
// custom (account_type, school_id, suspended...) pode ser enviado pelo
// cliente logado. Aplicar FLS write admin-only nesses campos quebraria o
// completeSignup, que usa auth.updateMe no contexto do próprio usuário para
// gravar papel/escola. Mitigação adotada: TODAS as functions sensíveis
// revalidam papel/vínculo no servidor (via service role) e recusam
// user.suspended === true logo no início — um auto-promovido não ganha
// acesso a dados de terceiros por nenhuma function.
// O RLS abaixo fecha a superfície da ENTIDADE: leitura só do próprio
// registro ou admin; update/delete de entidade só admin (o cliente nunca usa
// entities.User.update — mutações passam por adminUpdateAccount etc.).
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "director"
      ],
      "default": "student",
      "description": "Tipo de perfil no Reda\u00e7\u00e3oPro \u2014 definido pelo servidor a partir do c\u00f3digo de acesso"
    },
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio (full_name \u00e9 read-only no sistema)"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "cpf": {
      "type": "string",
      "description": "CPF somente d\u00edgitos"
    },
    "registered_id": {
      "type": "string",
      "description": "ID p\u00fablico \u00fanico da conta (ADM-/DIR-/PRO-/ALU-XXXXXX), gerado no servidor no cadastro"
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "Conta suspensa pelo admin \u2014 bloqueia o acesso ao app"
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}