{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "student",
        "teacher"
      ],
      "default": "student",
      "description": "Tipo de perfil no Reda\u00e7\u00e3oPro"
    }
  },
  "required": [
    "role"
  ]
}