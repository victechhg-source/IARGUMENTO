{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "student",
        "teacher",
        "director"
      ],
      "default": "student",
      "description": "Tipo de perfil \u2014 gravado s\u00f3 pelo servidor",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "school_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "school_name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio (full_name \u00e9 read-only no sistema)"
    },
    "planner_plan": {
      "type": "object",
      "description": "Plano de estudos ativo do aluno (gerado pelo Planejador). Persiste at\u00e9 ele criar outro.",
      "properties": {
        "plan": {
          "type": "object"
        },
        "peakTime": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "rls": {
        "read": true
      }
    },
    "registered_id": {
      "type": "string",
      "description": "ID p\u00fablico \u00fanico da conta (ADM-/DIR-/PRO-/ALU-XXXXXX), gerado no servidor no cadastro",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "Conta suspensa pelo admin \u2014 bloqueia o acesso ao app",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}